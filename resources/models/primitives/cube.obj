# Cube primitive (2x2x2, centered at origin)
# 8 vertices, 12 triangles (6 faces)

# Vertices
v -1.0 -1.0  1.0  # 0: front-bottom-left
v  1.0 -1.0  1.0  # 1: front-bottom-right
v  1.0  1.0  1.0  # 2: front-top-right
v -1.0  1.0  1.0  # 3: front-top-left
v -1.0 -1.0 -1.0  # 4: back-bottom-left
v  1.0 -1.0 -1.0  # 5: back-bottom-right
v  1.0  1.0 -1.0  # 6: back-top-right
v -1.0  1.0 -1.0  # 7: back-top-left

# Normals
vn  0.0  0.0  1.0  # front
vn  0.0  0.0 -1.0  # back
vn  1.0  0.0  0.0  # right
vn -1.0  0.0  0.0  # left
vn  0.0  1.0  0.0  # top
vn  0.0 -1.0  0.0  # bottom

# Texture coordinates
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Faces (CCW winding)
# Front face (+Z)
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1

# Back face (-Z)
f 6/1/2 5/2/2 4/3/2
f 6/1/2 4/3/2 7/4/2

# Right face (+X)
f 2/1/3 6/2/3 7/3/3
f 2/1/3 7/3/3 3/4/3

# Left face (-X)
f 5/1/4 1/2/4 4/3/4
f 5/1/4 4/3/4 8/4/4

# Top face (+Y)
f 4/1/5 3/2/5 7/3/5
f 3/1/5 6/2/5 7/3/5

# Bottom face (-Y)
f 5/1/6 2/2/6 1/3/6
f 5/1/6 6/2/6 2/3/6
